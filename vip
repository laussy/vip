TAKES = {'-d': 'depth', '--depth': 'depth', '-n': 'top', '--top': 'top', '-r': 'rank', '--rank': 'rank',
         '--min-cites': 'min_cites', '--since': 'since', '--until': 'until', '--type': 'type',
         '--topic': 'topic', '--max': 'max', '--pool': 'pool', '-b': 'bib', '--bib': 'bib',
         '-f': 'format', '--format': 'format', '-o': 'output', '--output': 'output',
         '-W': 'width', '--width': 'width', '--mailto': 'mailto', '--openalex-key': 'openalex_key'}
FLAGS = {'--no-self': 'no_self', '--no-links': 'no_links', '--fresh': 'fresh', '-q': 'quiet', '--quiet': 'quiet'}


def parse_args(argv):
    o = {'depth': None, 'top': ['5'], 'rank': 'rate', 'min_cites': 0, 'since': None, 'until': None,
         'type': [], 'topic': None, 'no_self': False, 'max': 300, 'pool': 200, 'bib': [],
         'format': None, 'output': None, 'width': None, 'no_links': False, 'fresh': False,
         'mailto': os.environ.get('VIP_MAILTO'), 'openalex_key': os.environ.get('OPENALEX_API_KEY'),
         'quiet': False}
    for a in argv:
        if a in ('-h', '--help'):
            print(__doc__.strip())
            sys.exit(0)
        if a in ('-V', '--version'):
            print('vip', __version__, '(citing %s)' % C.__version__)
            sys.exit(0)
    lists = {'bib': 'split', 'type': 'split', 'top': 'split'}
    ints = ('depth', 'min_cites', 'since', 'until', 'max', 'pool', 'width')
    pos = []
    given = C.parse_options(argv, o, TAKES, FLAGS, lists, ints, 'vip', pos)
    rc = dict(o)
    for k in lists:
        rc[k] = []
    rc_given = C.parse_options(C.read_rc('VIP_RC', 'vip'), rc, TAKES, FLAGS, lists, ints, 'vip (~/.viprc)', None)
    for k in rc_given - given:
        o[k] = rc[k]
    # what ~/.citingrc says of the bibliography and of OpenAlex
    crc = {}
    try:
        cg = C.parse_options(C.read_rc('CITING_RC', 'citing'), crc, C.TAKES, C.FLAGS,
                             {'bib': 'split', 'own': 'split', 'hunt': 'raw'}, ('since', 'hunt_since', 'hunt_max'),
                             'vip (~/.citingrc)', None)
    except SystemExit:
        cg = set()
    for k in ('bib', 'mailto', 'openalex_key'):
        if k in cg and k not in given | rc_given:
            o[k] = crc[k]
    if not pos:
        print(__doc__.strip())
        sys.exit(1)
    if len(pos) > 1:
        sys.exit('vip: one paper at a time')
    o['paper'] = pos[0]
    try:
        o['top'] = [int(x) for x in o['top']]
    except ValueError:
        sys.exit('vip: --top takes numbers, e.g. 5 or 10,5,3')
    if any(t < 1 for t in o['top']):
        sys.exit('vip: --top numbers must be 1 or more')
    if o['depth'] is None:
        o['depth'] = len(o['top']) if 'top' in given | rc_given and len(o['top']) > 1 else 2
    if o['rank'] not in ('rate', 'recent', 'cites'):
        sys.exit('vip: --rank is rate, recent or cites')
    ext = os.path.splitext(o['output'] or '')[1].lower().lstrip('.')
    if o['format'] is None:
        o['format'] = {'json': 'json', 'dot': 'dot', 'gv': 'dot', 'svg': 'dot', 'pdf': 'dot', 'png': 'dot',
                       'wiki': 'wiki', 'txt': 'text'}.get(ext, 'text')
    if o['format'] not in ('text', 'json', 'dot', 'wiki', 'keys', 'ids'):
        sys.exit('vip: --format is text, json, dot, wiki, keys or ids')
    if ext in ('svg', 'pdf', 'png') and o['format'] != 'dot':
        sys.exit('vip: a .%s is drawn from the dot format' % ext)
    o['render'] = ext if ext in ('svg', 'pdf', 'png') else None
    return o


def main(argv):
    global FRESH
    o = parse_args(argv)
    C.QUIET, C.MAILTO, C.OPENALEX_KEY = o['quiet'], o['mailto'], o['openalex_key']
    FRESH = o['fresh']
    if o['render'] and not shutil.which('dot'):
        sys.exit('vip: drawing a .%s needs Graphviz (dot); -f dot writes the source' % o['render'])

    bib = C.Bib(o['bib']) if o['bib'] else None
    s = C.resolve(o['paper'], bib, prog='vip')
    ident = s['wid'] or 'doi:' + s['doi']
    x = C.openalex_work(ident, select=SEL)
    if not x:
        sys.exit('vip: OpenAlex has no work for %s' % C.label(s))
    seed = Work(x)
    if bib:
        seed.set_key(bib, s['key'])

    by = {'rate': 'citations per year', 'recent': 'citations in %d–%d' % (TODAY.year - 2, TODAY.year),
          'cites': 'citations'}[o['rank']]
    tops = ','.join(map(str, o['top']))
    only = [x for x in (
        o['topic'] and 'on "%s"' % o['topic'],
        o['type'] and 'type %s' % '|'.join(o['type']),
        o['since'] and 'from %d' % o['since'],
        o['until'] and 'to %d' % o['until'],
        o['min_cites'] and 'cited %d+ times' % o['min_cites'],
        o['no_self'] and 'no self-citations') if x]
    desc = '%s (%s %s): %d generation%s, top %s by %s%s, OpenAlex %s' % (
        seed.ident(), seed.first(), seed.year or '', o['depth'], 's' if o['depth'] > 1 else '', tops, by,
        ' (%s)' % ', '.join(only) if only else '', '%d %s' % (TODAY.day, TODAY.strftime('%b %Y')))
    say('vip %s: %s' % (__version__, desc))
    grow(o, seed, bib)
    number(seed)
    nodes = list(walk(seed))

    f = o['format']
    width = None
    if f == 'text':
        if o['width']:
            width = o['width']
        elif not o['output'] and sys.stdout.isatty():
            width = shutil.get_terminal_size((160, 40)).columns
        out = text(o, seed, width)
    elif f == 'json':
        out = as_json(o, seed, desc)
    elif f == 'dot':
        out = dot(o, seed, desc)
    elif f == 'wiki':
        out = wiki(o, seed)
    elif f == 'keys':
        out = ''.join(w.key + '\n' for w in nodes if w.key)
    else:
        out = ''.join(w.ident() + '\n' for w in nodes if not w.key and (w.doi or w.arxiv))

    if o['render']:
        r = subprocess.run(['dot', '-T' + o['render'], '-o', o['output']], input=out.encode(), capture_output=True)
        if r.returncode:
            sys.exit('vip: dot failed: ' + r.stderr.decode(errors='replace').strip())
    elif o['output']:
        with open(o['output'], 'w', encoding='utf-8') as fh:
            fh.write(out)
    else:
        sys.stdout.write(out)

    links = sum(len(w.links) for w in nodes)
    inbib = sum(bool(w.key) for w in nodes)
    left = (C.BUDGET.get('api.openalex.org') or {}).get('x-ratelimit-remaining')
    gens = max(w.depth for w in nodes)
    say('%d works in %d generation%s%s%s; OpenAlex: %d queries, %d from the cache%s%s' % (
        len(nodes), gens, '' if gens == 1 else 's',
        ', %d seen again ("see")' % links if links else '',
        ', %d in the bib files' % inbib if bib else '',
        C.CALLS.get('api.openalex.org', 0), STATS['cached'],
        ', %s credits left today' % left if left else '',
        '; written to ' + o['output'] if o['output'] else ''))


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        pass
